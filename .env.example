# ShiftFlow Studio — environment configuration (see DEPLOYMENT_GUIDE.md section 3)

# REQUIRED. Signs login session cookies. Use a random value of at least 32 characters and keep it
# private. The backend refuses to start with a short value or this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SHIFTFLOW_SESSION_SECRET=change-me-generate-a-random-value-see-comment-above

# "false" closes public sign-up. Create accounts with: docker compose exec backend python -m app.create_user EMAIL
SHIFTFLOW_ALLOW_SIGNUP=true

# "false" lets the session cookie travel over plain http, for example a LAN address without https.
# Leave "true" (the default) for anything on the public internet.
SHIFTFLOW_COOKIE_SECURE=true

SHIFTFLOW_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SHIFTFLOW_DB_PATH=data/shiftflow.db
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local development without Docker only: run the backend with no login at all.
# Never set this on a server other people can reach.
# SHIFTFLOW_AUTH_DISABLED=1

# Modules built for an earlier, broader "enterprise workforce OS" phase. They are kept
# in the codebase but default off, outside the V1 product surface. Set any of these to
# "1"/"true" to turn that module's API routes back on (otherwise they return 404).
# SHIFTFLOW_ENABLE_POS_INTEGRATION=1
# SHIFTFLOW_ENABLE_EMERGENCY_WORKFLOWS=1
# SHIFTFLOW_ENABLE_SHIFT_HANDOVER=1
