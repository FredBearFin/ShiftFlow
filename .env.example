# ShiftFlow Studio Enterprise — Environment Configuration
APP_ENV=production
LOG_LEVEL=info
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Becker (EJOR 2026) Shift Design Objective Weights (Table 3)
WEIGHT_EMPLOYEES=5.0
WEIGHT_SHIFT_TYPES=60.0
WEIGHT_OVERSTAFFING=1.0
WEIGHT_UNDERSTAFFING=1.0

# Default Pareto Frontier Leeway (% allowed increase in obj^shift; 5.0 = Knee Point)
DEFAULT_PARETO_LEEWAY_PCT=5.0
MIN_REST_HOURS_BETWEEN_SHIFTS=16
